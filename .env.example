# ── Sign-in ─────────────────────────────────────────────────────────────
# The one account that can use the app. The sign-in page is public, so use a long password
# (at least 12 characters). Changing it signs everyone out.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
# Signs the session cookie (at least 32 characters). Generate one: openssl rand -hex 32
# Changing it also signs everyone out.
SESSION_SECRET=

# ── Database (Supabase) ─────────────────────────────────────────────────
# Transaction pooler URL, port 6543.
DATABASE_URL=postgresql://postgres.[project-id]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
SUPABASE_URL=https://[project-id].supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Encryption ──────────────────────────────────────────────────────────
# Not used to protect anything yet. SSH passwords, Mailcow API keys and admin passwords, and the
# Cloudflare token are stored as PLAIN TEXT in the database, so keep DATABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY secret and limit who can open the Supabase project.
# The app only uses this key to read a value that was stored encrypted, if one exists. If you already
# have a key (base64 of 32 bytes), keep the same value everywhere this database is used.
ENCRYPTION_KEY=

# ── Server-setup queue ──────────────────────────────────────────────────
# docker-compose.yml runs its own Redis and ignores this value.
# Optional: if unset or unreachable, server setup runs inside the app process (at most
# PROVISION_CONCURRENCY at once, default 3) and does not survive an app restart.
REDIS_URL=redis://localhost:6379
# PROVISION_CONCURRENCY=3
# Only on the production server (docker-compose.yml already sets it there): resume setup runs an app
# restart interrupted, at the step they were on. Leave it unset on a dev server or local build that shares
# the database: it can't see the production queue and would resume runs that are still going there.
# SETUP_RECONCILE=1

# ── Mailcow ─────────────────────────────────────────────────────────────
# MAILCOW_DEFAULT_QUOTA_MB=
# Servers the app must never set up (install or reuse Mailcow on), comma-separated IPs, e.g. a mail
# server with live mailboxes you manage by hand. A setup run on one stops at its Server step.
# PROTECTED_SERVER_IPS=203.0.113.10,203.0.113.11

# ── VPS deploy (docker-compose) ─────────────────────────────────────────
# Public hostname for the app. Its DNS A record must point at the VPS.
DOMAIN=app.example.com
