# ── Sign-in ─────────────────────────────────────────────────────────────
# The one account that can use the app. The sign-in page is public, so use a long password
# (at least 12 characters). Changing it signs everyone out.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
# Signs the session cookie (at least 32 characters). Generate one: openssl rand -hex 32
SESSION_SECRET=

# ── Database (Supabase) ─────────────────────────────────────────────────
# Transaction pooler URL, port 6543.
DATABASE_URL=postgresql://postgres.[project-id]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
SUPABASE_URL=https://[project-id].supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Encryption ──────────────────────────────────────────────────────────
# Encrypts stored SSH passwords and API keys: base64 of 32 bytes (openssl rand -base64 32).
# Must be the SAME value everywhere the app uses this database, or stored credentials can't be read.
ENCRYPTION_KEY=

# ── Server-setup queue ──────────────────────────────────────────────────
# docker-compose.yml runs its own Redis and ignores this value.
# Optional: if unset or unreachable, server setup runs inside the app process (at most
# PROVISION_CONCURRENCY at once, default 3) and does not survive an app restart.
REDIS_URL=redis://localhost:6379
# PROVISION_CONCURRENCY=3

# ── Mailcow ─────────────────────────────────────────────────────────────
# MAILCOW_DEFAULT_QUOTA_MB=

# ── VPS deploy (docker-compose) ─────────────────────────────────────────
# Public hostname for the app. Its DNS A record must point at the VPS.
DOMAIN=app.example.com
